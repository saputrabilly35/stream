<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Starting Soon</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#08080a;
    --panel:#131316;
    --silver-bright:#f1f3f4;
    --silver:#b9bec3;
    --silver-dim:#6c7175;
    --hairline:rgba(185,190,195,.28);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{
    width:1920px;height:1080px;
    background:var(--void);
    overflow:hidden;
    font-family:'Inter',sans-serif;
  }

  /* subtle brushed-metal backdrop */
  .backdrop{
    position:absolute;inset:0;
    background:
      repeating-linear-gradient(115deg, rgba(255,255,255,.015) 0px, rgba(255,255,255,.015) 1px, transparent 1px, transparent 4px),
      radial-gradient(circle at 50% 45%, #17181b 0%, #08080a 70%);
  }
  .grid-lines{
    position:absolute;inset:0;
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size:96px 96px;
    opacity:.05;
  }

  /* scanning sweep */
  .sweep{
    position:absolute;top:0;bottom:0;width:340px;
    background:linear-gradient(90deg, transparent, rgba(255,255,255,.05), transparent);
    animation:sweep 7s linear infinite;
  }
  @keyframes sweep{
    0%{ transform:translateX(-400px);}
    100%{ transform:translateX(1920px);}
  }

  .stage{
    position:relative;
    width:100%;height:100%;
    display:flex;align-items:center;justify-content:center;
  }

  /* chamfered HUD frame */
  .frame-outer{
    position:relative;
    width:1160px;
    padding:3px;
    background:linear-gradient(155deg, var(--silver-bright), var(--silver-dim) 40%, var(--silver) 100%);
    clip-path:polygon(40px 0,100% 0,100% calc(100% - 40px),calc(100% - 40px) 100%,0 100%,0 40px);
  }
  .frame-inner{
    background:var(--panel);
    clip-path:polygon(38px 0,100% 0,100% calc(100% - 38px),calc(100% - 38px) 100%,0 100%,0 38px);
    padding:86px 100px 74px;
    text-align:center;
    position:relative;
  }

  .tick{position:absolute;width:26px;height:26px;border:2px solid var(--silver-bright);opacity:.85;}
  .tick.tl{top:-14px;left:-14px;border-right:none;border-bottom:none;}
  .tick.tr{top:-14px;right:-14px;border-left:none;border-bottom:none;}
  .tick.bl{bottom:-14px;left:-14px;border-right:none;border-top:none;}
  .tick.br{bottom:-14px;right:-14px;border-left:none;border-top:none;}

  .eyebrow{
    font-family:'Rajdhani',sans-serif;
    font-weight:600;
    letter-spacing:.6em;
    font-size:22px;
    color:var(--silver-dim);
    margin-bottom:28px;
  }
  .eyebrow .dot{
    display:inline-block;width:9px;height:9px;border-radius:50%;
    background:var(--silver-bright);margin-right:16px;
    box-shadow:0 0 12px 2px rgba(255,255,255,.6);
    animation:blink 1.6s ease-in-out infinite;
    vertical-align:middle;
  }
  @keyframes blink{0%,100%{opacity:1;}50%{opacity:.25;}}

  .handle{
    font-family:'Orbitron',sans-serif;
    font-weight:800;
    font-size:104px;
    letter-spacing:.02em;
    background:linear-gradient(180deg, var(--silver-bright) 0%, var(--silver) 55%, var(--silver-dim) 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    line-height:1;
  }

  .subline{
    margin-top:30px;
    font-family:'Rajdhani',sans-serif;
    font-weight:600;
    font-size:34px;
    letter-spacing:.08em;
    color:var(--silver);
    text-transform:uppercase;
  }

  .hairline-row{
    margin-top:56px;
    display:flex;align-items:center;justify-content:center;gap:24px;
  }
  .hairline-row .line{height:1px;width:220px;background:linear-gradient(90deg, transparent, var(--hairline), transparent);}
  .hairline-row .socials{
    font-family:'Rajdhani',sans-serif;
    font-size:22px;font-weight:600;letter-spacing:.15em;
    color:var(--silver-dim);
  }
</style>
</head>
<body>
  <div class="backdrop"></div>
  <div class="grid-lines"></div>
  <div class="sweep"></div>

  <div class="stage">
    <div class="frame-outer">
      <div class="frame-inner">
        <div class="tick tl"></div>
        <div class="tick tr"></div>
        <div class="tick bl"></div>
        <div class="tick br"></div>

        <div class="eyebrow"><span class="dot"></span>STARTING SOON</div>
        <div class="handle">billyftw_</div>
        <div class="subline">is starting his live soon!</div>

        <div class="hairline-row">
          <div class="line"></div>
          <div class="socials">YOUTUBE / INSTAGRAM &nbsp;·&nbsp; @billyftw_</div>
          <div class="line"></div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
